     3                                  ; Project 2 ShellCode
     4                                  ; how to compile: make compile
     5                                  ; Description: Opens a file called win, and writes output to stdout
     6                                  
     7                                  bits 64
     8                                  
     9                                  ;section .data
    10                                  ;    ;define win file name and bin/sh
    11                                  ;    win db './///win', 0x0
    12                                  ;    bin db '//bin/sh', 0x0
    13                                  ;    ;winFd db '', 0x0
    14                                  
    15                                  section .text
    16                                      global _start
    17                                  
    18                                  ;;;;;;;;;;;;NOTES;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    19                                          ; function args 1:rdi, 2:rsi, 3:rcx, 4:rdx, 5:r8, 6:r9
    20                                          ; frame pointer: rbp
    21                                          ; function return value: rax
    22                                  
    23                                          ; sys_write(int fd, const void buf[.count], size_t count)
    24                                          ; rax = 1
    25                                  
    26                                          ; sys_read(int fd, void buf[.count], size_t count)
    27                                          ; rax = 0
    28                                  
    29                                          ;convention: syscall NR:rax, return:rax, arg0:rdi, arg1:rsi, arg2:rdx, arg3:r10  ...r8...r9
    30                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    31                                  
    32                                  _start:
    33                                  
    34                                  ;;;;;;;;;;;;;;;ORIGINAL COPYCAT STDIN;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    35                                      ;read in from stdin
    36                                      ;mov al, 1 ; set syscall number to (sys_read + 1)
    37                                      ;sub al, 1 ; set syscall number to (sys_read)
    38                                      ;mov dil, 1 ; set file desctriptor to (stdin + 1)
    39                                      ;sub dil, 1  ;file descriptor set to 0 (stdin)
    40                                      ;add rsp, 8  ;increment the stack pointer by 1 byte
    41                                      ;mov rsi, rsp ;set buffer to stack pointer
    42                                      ;mov dl, 1  ;just read one bit
    43                                      ;syscall
    44                                  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    45                                  
    46                                      ;open win file
    47                                      ;int fd = open('.////win', O_RDONLY, NULL)
    48                                      ;int open(const char *pathname, int flags, /* mode_t mode */)
    49 00000000 B002                        mov al, 2 ; set syscall number to (sys_open)
    50 00000002 48BF-                       mov rdi, win ; set filename to win;
    50 00000004 [4E00000000000000] 
    51 0000000C BE00000000                  mov rsi, 0 ;set flag to O_RDONLY
    52 00000011 B200                        mov dl, 0  ;set mode to null/0
    53 00000013 0F05                        syscall
    54 00000015 4989C2                      mov r10, rax;move fd to variable
    55                                  
    56                                  _read:
    57                                      
    58                                      ;read in from the file
    59 00000018 B000                        mov al, 0 ; set syscall number to (sys_read)
    60 0000001A 4C89D7                      mov rdi, r10 ; set file desctriptor to (winFd)   ;dil to rdi
    61 0000001D 4883C408                    add rsp, 8  ;increment the stack pointer by 1 byte
    62 00000021 4889E6                      mov rsi, rsp ;set buffer to stack pointer
    63 00000024 B201                        mov dl, 1  ;just read one bit
    64 00000026 0F05                        syscall
    65                                  
    66                                      ;check if eof or error was reached
    67 00000028 4883C001                    add rax, 1  ;add 1 to rax
    68 0000002C 4883F801                    cmp rax, 1  ;see if success (cmp rax+1, 1)
    69 00000030 740E                        je .done    ;if return value is zero(eof), then jump to done
    70                                  
    71                                      ;write to stdout
    72 00000032 B001                        mov al, 1  ;set syscall number to sys_write
    73 00000034 40B701                      mov dil, 1  ;file descriptor set to 1 (stdout)
    74 00000037 4889E6                      mov rsi, rsp ;set buffer to stack pointer
    75 0000003A B201                        mov dl, 1  ;just write one byte
    76 0000003C 0F05                        syscall
    77 0000003E EBD8                        jmp _read  ;loop back to the beginning
    78                                  
    79                                  .done:
    80                                  
    81                                      ;syscall for exit
    82 00000040 4831C0                      xor rax, rax
    83 00000043 B03C                        mov al, 60    ;syscall for sys_exit
    84 00000045 40B701                      mov dil, 1  ;set status code to (success + 1)
    85 00000048 4080EF01                    sub dil, 1  ;set status code 0 (success)
    86 0000004C 0F05                        syscall
    87                                      
    88                                  win:
    89 0000004E 2E2F2F2F2F77696E00          db './///win', 0x0
